DIC Lab 11: 03_coupled_wires
* MODEL_SETUP_REQUIRED
* Handout-based simulation at 1 V; this condition is not a model voltage rating.
.option post=2 nomod runlvl=6 measdgt=10 numdgt=10 ingold=2
.temp 27
.param VS=1
VDD vdd 0 'VS'
.subckt INV a y vp vn wn=0.6u wp=1.8u ll=0.25u
MN y a vn vn nmos W=wn L=ll
MP y a vp vp pmos W=wp L=ll
.ends INV
.param LEN=2000 RUNIT=0.17 CCUNIT=.08 CGUNIT=.07 CSUNIT=.14
.param CEN=1 LEFT=1 RIGHT=1
VBASE base 0 PWL(0 0 20n 0 20.1n 1 120n 1)
EIN in 0 VOL='(1-CEN)/2+CEN*V(base)'
EL il 0 VOL='(LEFT==2)?0:((1-LEFT)/2+LEFT*V(base))'
ER ir 0 VOL='(RIGHT==2)?0:((1-RIGHT)/2+RIGHT*V(base))'
XDl il l0 vdd 0 INV wn='5*WNBASE' wp='5*WPBASE' ll=LBASE
XRl l3 outl vdd 0 INV wn=WNBASE wp=WPBASE ll=LBASE
Rl0 l0 l1 'RUNIT*LEN/3'
Rl1 l1 l2 'RUNIT*LEN/3'
Rl2 l2 l3 'RUNIT*LEN/3'
Cl0 l0 0 'CSUNIT*LEN*1f/6'
Cl1 l1 0 'CSUNIT*LEN*1f/3'
Cl2 l2 0 'CSUNIT*LEN*1f/3'
Cl3 l3 0 'CSUNIT*LEN*1f/6'
XDc in c0 vdd 0 INV wn='5*WNBASE' wp='5*WPBASE' ll=LBASE
XRc c3 outc vdd 0 INV wn=WNBASE wp=WPBASE ll=LBASE
Rc0 c0 c1 'RUNIT*LEN/3'
Rc1 c1 c2 'RUNIT*LEN/3'
Rc2 c2 c3 'RUNIT*LEN/3'
Cc0 c0 0 'CGUNIT*LEN*1f/6'
Cc1 c1 0 'CGUNIT*LEN*1f/3'
Cc2 c2 0 'CGUNIT*LEN*1f/3'
Cc3 c3 0 'CGUNIT*LEN*1f/6'
XDr ir r0 vdd 0 INV wn='5*WNBASE' wp='5*WPBASE' ll=LBASE
XRr r3 outr vdd 0 INV wn=WNBASE wp=WPBASE ll=LBASE
Rr0 r0 r1 'RUNIT*LEN/3'
Rr1 r1 r2 'RUNIT*LEN/3'
Rr2 r2 r3 'RUNIT*LEN/3'
Cr0 r0 0 'CSUNIT*LEN*1f/6'
Cr1 r1 0 'CSUNIT*LEN*1f/3'
Cr2 r2 0 'CSUNIT*LEN*1f/3'
Cr3 r3 0 'CSUNIT*LEN*1f/6'
CCl0 l0 c0 'CCUNIT*LEN*1f/6'
CCl1 l1 c1 'CCUNIT*LEN*1f/3'
CCl2 l2 c2 'CCUNIT*LEN*1f/3'
CCl3 l3 c3 'CCUNIT*LEN*1f/6'
CCr0 r0 c0 'CCUNIT*LEN*1f/6'
CCr1 r1 c1 'CCUNIT*LEN*1f/3'
CCr2 r2 c2 'CCUNIT*LEN*1f/3'
CCr3 r3 c3 'CCUNIT*LEN*1f/6'
.tran 20p 120n
.print tran V(in) V(il) V(ir) V(outc)
.measure tran tin WHEN V(in)=0.5 CROSS=1
.measure tran tout WHEN V(outc)=0.5 CROSS=1
.measure tran delay PARAM='tout-tin'
.param LEN=2000 RUNIT=0.17 CCUNIT=0.08 CGUNIT=0.07 CSUNIT=0.14 CEN=1 LEFT=1 RIGHT=1 WNBASE=.9u WPBASE=2.7u LBASE=.35u
.temp 27

